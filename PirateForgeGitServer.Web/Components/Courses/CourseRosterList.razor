@using PirateForgeGitServer.Contracts.Courses
@rendermode InteractiveServer

<FluentCard Class="data-grid-card">
    @if (Students.Count == 0)
    {
        <div class="empty-state">No students are enrolled in this course.</div>
    }
    else
    {
        <div class="grid-toolbar">
            <FluentTextInput @bind-Value="filter"
                             Label="Filter students"
                             Placeholder="Search name or email"
                             Type="TextInputType.Search"
                             Immediate="true"
                             ImmediateDelay="150" />
            <span class="grid-count">@filteredStudents.Count student(s)</span>
        </div>
        @if (filteredStudents.Count == 0)
        {
            <div class="empty-state">No students match your filter.</div>
        }
        else
        {
            <div class="data-grid-scroll">
                <FluentDataGrid Items="@filteredStudents.AsQueryable()"
                                TGridItem="CourseStudentResponse"
                                ResizableColumns="true"
                                ShowHover="true"
                                MultiLine="true">
                    <PropertyColumn Property="@(student => student.DisplayName)"
                                    Title="Name"
                                    Sortable="true"
                                    IsDefaultSortColumn="true" />
                    <PropertyColumn Property="@(student => student.Email)"
                                    Title="Email"
                                    Sortable="true" />
                    <PropertyColumn Property="@(student => student.EnrolledAt)"
                                    Title="Enrolled"
                                    Format="d"
                                    Sortable="true" />
                </FluentDataGrid>
            </div>
        }
    }
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<CourseStudentResponse> Students { get; set; }

    private string? filter;
    private IReadOnlyList<CourseStudentResponse> filteredStudents =>
        string.IsNullOrWhiteSpace(filter)
            ? Students
            : Students.Where(student =>
                    student.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || student.Email.Contains(filter, StringComparison.OrdinalIgnoreCase))
                .ToList();
}
