@using PirateForgeGitServer.Contracts.Git
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="repository-branch-picker">
    <FluentSelect Label="Branch"
                  TOption="RepositoryBranchResponse"
                  TValue="string"
                  @bind-Value="selectedBranch"
                  @bind-Value:after="NavigateToBranch">
        @foreach (var branch in Branches)
        {
            <FluentOption TValue="string" Value="@branch.Name">
                @branch.Name
            </FluentOption>
        }
    </FluentSelect>
</div>

@code {
    [Parameter, EditorRequired]
    public required string RepositoryName { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<RepositoryBranchResponse> Branches { get; set; }

    [Parameter, EditorRequired]
    public required string SelectedBranch { get; set; }

    private string selectedBranch = string.Empty;

    protected override void OnParametersSet()
    {
        selectedBranch = SelectedBranch;
    }

    private void NavigateToBranch()
    {
        if (string.IsNullOrWhiteSpace(selectedBranch)
            || string.Equals(selectedBranch, SelectedBranch, StringComparison.Ordinal))
        {
            return;
        }

        Navigation.NavigateTo(
            $"/repositories/{RepositoryName}?branch={Uri.EscapeDataString(selectedBranch)}",
            forceLoad: true);
    }
}
