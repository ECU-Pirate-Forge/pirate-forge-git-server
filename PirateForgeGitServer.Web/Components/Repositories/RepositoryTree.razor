@using PirateForgeGitServer.Contracts.Git

<FluentCard>
    <h2>Files</h2>
    <nav aria-label="Breadcrumb">
        <FluentLink Href="@RootUrl">@RepositoryName</FluentLink>
        @foreach (var crumb in Breadcrumbs)
        {
            <span aria-hidden="true"> / </span>
            <FluentLink Href="@crumb.Url">@crumb.Name</FluentLink>
        }
    </nav>

    <table class="repository-table">
        <thead>
            <tr><th>Name</th><th>Size</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in Entries)
            {
                <tr>
                    <td>
                        <FluentLink Href="@EntryUrl(entry)">
                            @(entry.Kind == "directory" ? "Folder" : "File") · @entry.Name
                        </FluentLink>
                    </td>
                    <td>@(entry.Size is null ? "—" : $"{entry.Size:N0} bytes")</td>
                </tr>
            }
        </tbody>
    </table>
</FluentCard>

@code {
    [Parameter, EditorRequired] public required string RepositoryName { get; set; }
    [Parameter, EditorRequired] public required string Branch { get; set; }
    [Parameter] public string? Path { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<RepositoryTreeEntryResponse> Entries { get; set; }

    private string RootUrl =>
        $"/repositories/{RepositoryName}?branch={Uri.EscapeDataString(Branch)}";

    private IEnumerable<(string Name, string Url)> Breadcrumbs
    {
        get
        {
            var current = string.Empty;
            foreach (var segment in (Path ?? string.Empty).Split(
                         '/',
                         StringSplitOptions.RemoveEmptyEntries))
            {
                current = string.IsNullOrEmpty(current)
                    ? segment
                    : $"{current}/{segment}";
                yield return (
                    segment,
                    $"{RootUrl}&path={Uri.EscapeDataString(current)}");
            }
        }
    }

    private string EntryUrl(RepositoryTreeEntryResponse entry) =>
        entry.Kind == "directory"
            ? $"{RootUrl}&path={Uri.EscapeDataString(entry.Path)}"
            : $"{RootUrl}&file={Uri.EscapeDataString(entry.Path)}";
}
