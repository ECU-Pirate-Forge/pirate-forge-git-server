@using PirateForgeGitServer.Contracts.Git

<FluentCard Class="repository-panel repository-tree-panel">
    <div class="repository-panel-header">
        <div>
            <h2>Files</h2>
            <span>@Entries.Count item@(Entries.Count == 1 ? string.Empty : "s") on @Branch</span>
        </div>
    </div>

    <nav class="repository-path" aria-label="Repository path">
        <FluentLink Href="@RootUrl">Root</FluentLink>
        @foreach (var crumb in Breadcrumbs)
        {
            <span class="repository-path-separator" aria-hidden="true">/</span>
            <FluentLink Href="@crumb.Url">@crumb.Name</FluentLink>
        }
    </nav>

    @if (Entries.Count == 0)
    {
        <div class="repository-empty">This directory is empty.</div>
    }
    else
    {
        <div class="repository-tree-grid">
            <FluentDataGrid Items="@SortedEntries"
                            TGridItem="RepositoryTreeEntryResponse"
                            ShowHover="true"
                            GridTemplateColumns="minmax(18rem, 1fr) 9rem">
                <TemplateColumn Title="Name">
                    <div class="repository-entry">
                        <FluentIcon Value="@EntryIcon(context)"
                                    Color="@Color.Default"
                                    Title="@EntryType(context)" />
                        <FluentLink Href="@EntryUrl(context)">@context.Name</FluentLink>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Size" Align="@DataGridCellAlignment.End">
                    <span class="repository-size">@FormatSize(context.Size)</span>
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</FluentCard>

@code {
    [Parameter, EditorRequired] public required string RepositoryName { get; set; }
    [Parameter, EditorRequired] public required string Branch { get; set; }
    [Parameter] public string? Path { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<RepositoryTreeEntryResponse> Entries { get; set; }

    private static readonly Icon FolderIcon = new(
        "Folder",
        IconVariant.Regular,
        IconSize.Size20,
        "<path d=\"M2 5.75A2.75 2.75 0 0 1 4.75 3h2.79c.69 0 1.35.27 1.84.76l.86.86c.24.24.57.38.91.38h4.1A2.75 2.75 0 0 1 18 7.75v6.5A2.75 2.75 0 0 1 15.25 17H4.75A2.75 2.75 0 0 1 2 14.25v-8.5Zm2.75-1.25c-.69 0-1.25.56-1.25 1.25v8.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25h-4.1c-.74 0-1.45-.3-1.97-.82l-.86-.86a1.1 1.1 0 0 0-.78-.32H4.75Z\"/>");
    private static readonly Icon FileIcon = new(
        "Document",
        IconVariant.Regular,
        IconSize.Size20,
        "<path d=\"M5.75 2A2.75 2.75 0 0 0 3 4.75v10.5A2.75 2.75 0 0 0 5.75 18h8.5A2.75 2.75 0 0 0 17 15.25V7.62c0-.73-.29-1.43-.81-1.94l-2.87-2.87A2.75 2.75 0 0 0 11.38 2H5.75Zm0 1.5h5.5v3c0 .69.56 1.25 1.25 1.25h3v7.5c0 .69-.56 1.25-1.25 1.25h-8.5c-.69 0-1.25-.56-1.25-1.25V4.75c0-.69.56-1.25 1.25-1.25Zm7 .44 2.31 2.31h-2.31V3.94Z\"/>");
    private static readonly Icon MarkdownIcon = new(
        "DocumentText",
        IconVariant.Regular,
        IconSize.Size20,
        "<path d=\"M5.75 2A2.75 2.75 0 0 0 3 4.75v10.5A2.75 2.75 0 0 0 5.75 18h8.5A2.75 2.75 0 0 0 17 15.25V7.62c0-.73-.29-1.43-.81-1.94l-2.87-2.87A2.75 2.75 0 0 0 11.38 2H5.75Zm0 1.5h5.5v3c0 .69.56 1.25 1.25 1.25h3v7.5c0 .69-.56 1.25-1.25 1.25h-8.5c-.69 0-1.25-.56-1.25-1.25V4.75c0-.69.56-1.25 1.25-1.25Zm2 7h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Zm0 3h3a.75.75 0 0 1 0 1.5h-3a.75.75 0 0 1 0-1.5Z\"/>");

    private string RootUrl =>
        $"/repositories/{RepositoryName}?branch={Uri.EscapeDataString(Branch)}";

    private IQueryable<RepositoryTreeEntryResponse> SortedEntries =>
        Entries.OrderBy(entry => entry.Kind == "directory" ? 0 : 1)
            .ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase)
            .AsQueryable();

    private IEnumerable<(string Name, string Url)> Breadcrumbs
    {
        get
        {
            var current = string.Empty;
            foreach (var segment in (Path ?? string.Empty).Split(
                         '/',
                         StringSplitOptions.RemoveEmptyEntries))
            {
                current = string.IsNullOrEmpty(current)
                    ? segment
                    : $"{current}/{segment}";
                yield return (
                    segment,
                    $"{RootUrl}&path={Uri.EscapeDataString(current)}");
            }
        }
    }

    private string EntryUrl(RepositoryTreeEntryResponse entry) =>
        entry.Kind == "directory"
            ? $"{RootUrl}&path={Uri.EscapeDataString(entry.Path)}"
            : $"{RootUrl}&file={Uri.EscapeDataString(entry.Path)}";

    private static Icon EntryIcon(RepositoryTreeEntryResponse entry) =>
        entry.Kind == "directory"
            ? FolderIcon
            : IsMarkdown(entry.Name) ? MarkdownIcon : FileIcon;

    private static string EntryType(RepositoryTreeEntryResponse entry) =>
        entry.Kind == "directory"
            ? "Directory"
            : IsMarkdown(entry.Name) ? "Markdown file" : "File";

    private static bool IsMarkdown(string name) =>
        name.EndsWith(".md", StringComparison.OrdinalIgnoreCase)
        || name.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long? size)
    {
        if (size is null)
        {
            return "—";
        }

        if (size < 1024)
        {
            return $"{size:N0} B";
        }

        if (size < 1024 * 1024)
        {
            return $"{size / 1024d:N1} KB";
        }

        return $"{size / (1024d * 1024d):N1} MB";
    }
}
