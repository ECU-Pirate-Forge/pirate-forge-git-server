@page "/courses"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using PirateForgeGitServer.Contracts.Courses
@using PirateForgeGitServer.Web.Courses
@inject CourseApiClient CourseApi

<PageTitle>Courses</PageTitle>

<div class="page-header">
    <div>
        <h1>Courses</h1>
        <p>Create and manage the courses available to you.</p>
    </div>
    <AuthorizeView Roles="Administrator,Instructor">
        <Authorized>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary"
                                Href="@(ShowCreateForm ? "/courses" : "/courses?action=create")"
                                data-enhance-nav="false">
                @(ShowCreateForm ? "Close form" : "Add course")
            </FluentAnchorButton>
        </Authorized>
    </AuthorizeView>
</div>

@if (Error == "duplicate")
{
    <FluentMessageBar Intent="MessageBarIntent.Error">
        A course with that code already exists.
    </FluentMessageBar>
}
else if (Error == "invalid")
{
    <FluentMessageBar Intent="MessageBarIntent.Error">
        Enter a valid course code and a course name of no more than 200 characters.
    </FluentMessageBar>
}

<AuthorizeView Roles="Administrator,Instructor">
    <Authorized>
        @if (ShowCreateForm)
        {
            <FluentCard Class="form-panel">
                <h2>Create a course</h2>
                <form method="post" action="/courses/create" class="course-form">
                    <AntiforgeryToken />
                    <FluentTextInput Name="Code"
                                     Label="Course code"
                                     Required="true"
                                     Width="100%" />
                    <FluentTextInput Name="Name"
                                     Label="Course name"
                                     Required="true"
                                     Width="100%" />
                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary">
                        Create course
                    </FluentButton>
                </form>
            </FluentCard>
        }
    </Authorized>
</AuthorizeView>

@if (courses.Count == 0)
{
    <FluentMessageBar Intent="MessageBarIntent.Info">
        No courses are available.
    </FluentMessageBar>
}
else
{
    <CourseList Courses="@courses" />
}

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "action")] private string? Action { get; set; }
    private IReadOnlyList<CourseResponse> courses = [];
    private bool ShowCreateForm =>
        Action == "create" || Error is "duplicate" or "invalid";

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseApi.ListAsync();
    }
}
