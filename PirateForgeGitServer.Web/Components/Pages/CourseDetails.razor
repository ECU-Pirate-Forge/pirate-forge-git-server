@page "/courses/{Id:guid}"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using PirateForgeGitServer.Contracts.Courses
@using PirateForgeGitServer.Web.Courses
@using PirateForgeGitServer.Web.Assignments
@using PirateForgeGitServer.Web.Components.Assignments
@inject CourseApiClient CourseApi
@inject AssignmentApiClient AssignmentApi
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@course?.Code · Course</PageTitle>

@if (course is not null)
{
    <p><FluentLink Href="/courses">Courses</FluentLink> / @course.Code</p>
    <h1>@course.Name</h1>
    <p>@course.Code</p>

    @if (Error == "invalid-assignment")
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            The assignment could not be created. Check its slug, deadline, and starter template.
        </FluentMessageBar>
    }
    else if (Error == "provisioning")
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            The missing student repositories could not be provisioned. Try again.
        </FluentMessageBar>
    }
    else if (Error == "invalid-roster")
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            The roster could not be imported. Choose a valid UTF-8 CSV file no larger than 1 MiB.
        </FluentMessageBar>
    }
    else if (Error is "invalid-staff" or "staff-conflict")
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">
            The staff change could not be completed.
        </FluentMessageBar>
    }

    <CourseTabNavigation CourseId="@course.Id"
                         ActiveTab="@activeTab"
                         CanManage="@canManage" />

    <section class="course-tab-panel"
             aria-labelledby="@($"{activeTab}-heading")">
        @if (activeTab == AssignmentsTab)
        {
            <div class="course-tab-heading">
                <h2 id="assignments-heading">Assignments</h2>
                @if (canManage)
                {
                    <a class="course-tab-action"
                       href="@GetActionUrl(
                           AssignmentsTab,
                           activeAction == CreateAssignmentAction
                               ? null
                               : CreateAssignmentAction)"
                       data-enhance-nav="false">
                        @(activeAction == CreateAssignmentAction
                            ? "Close form"
                            : "Create assignment")
                    </a>
                }
            </div>
            <AssignmentList Assignments="@assignments"
                            CourseId="@course.Id"
                            CanManage="@canManage"
                            CanViewStatus="@canViewStatus" />
            @if (activeAction == CreateAssignmentAction)
            {
                <CreateAssignmentForm CourseId="@course.Id"
                                      Templates="@templates" />
            }
        }
        else if (activeTab == StudentsTab)
        {
            <div class="course-tab-heading">
                <h2 id="students-heading">Student Roster</h2>
                @if (canManage)
                {
                    <a class="course-tab-action"
                       href="@GetActionUrl(
                           StudentsTab,
                           activeAction == ImportStudentsAction
                               ? null
                               : ImportStudentsAction)"
                       data-enhance-nav="false">
                        @(activeAction == ImportStudentsAction
                            ? "Close form"
                            : "Import students")
                    </a>
                }
            </div>
            <CourseRosterList Students="@students" />
            @if (activeAction == ImportStudentsAction)
            {
                <ImportCourseRosterForm CourseId="@course.Id" />
            }
        }
        else if (activeTab == StaffTab)
        {
            <div class="course-tab-heading">
                <h2 id="staff-heading">Course staff</h2>
                @if (canManage)
                {
                    <a class="course-tab-action"
                       href="@GetActionUrl(
                           StaffTab,
                           activeAction == AddCourseStaffAction
                               ? null
                               : AddCourseStaffAction)"
                       data-enhance-nav="false">
                        @(activeAction == AddCourseStaffAction
                            ? "Close form"
                            : "Add course staff")
                    </a>
                }
            </div>
            <CourseStaffList CourseId="@course.Id"
                             Staff="@course.Staff"
                             CanManage="@canManage" />
            @if (activeAction == AddCourseStaffAction)
            {
                <AddCourseStaffForm CourseId="@course.Id"
                                    Candidates="@candidates" />
            }
        }
        else
        {
            <div class="course-tab-heading">
                <h2 id="activity-heading">Download activity</h2>
            </div>
            <CourseAuditList Events="@auditEvents" />
        }
    </section>
}
else
{
    <h1>Course not found</h1>
    <FluentMessageBar Intent="MessageBarIntent.Warning">
        The course does not exist or is not available to your account.
    </FluentMessageBar>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "action")] private string? Action { get; set; }

    private CourseResponse? course;
    private IReadOnlyList<CourseStaffCandidateResponse> candidates = [];
    private IReadOnlyList<CourseStudentResponse> students = [];
    private IReadOnlyList<AssignmentResponse> assignments = [];
    private IReadOnlyList<CourseAuditEventResponse> auditEvents = [];
    private IReadOnlyList<PirateForgeGitServer.Contracts.Git.RepositoryTemplateResponse> templates = [];
    private bool canManage;
    private bool canViewStatus;
    private string activeTab = AssignmentsTab;
    private string? activeAction;

    private const string AssignmentsTab = "assignments";
    private const string StudentsTab = "students";
    private const string StaffTab = "staff";
    private const string ActivityTab = "activity";
    private const string CreateAssignmentAction = "create-assignment";
    private const string ImportStudentsAction = "import-students";
    private const string AddCourseStaffAction = "add-course-staff";

    protected override async Task OnParametersSetAsync()
    {
        course = await CourseApi.GetAsync(Id);
        if (course is null)
        {
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdValue = state.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canManage = state.User.IsInRole("Administrator")
            || Guid.TryParse(userIdValue, out var userId)
            && course.Staff.Any(member =>
                member.UserId == userId
                && member.Role == "Instructor");
        canViewStatus = state.User.IsInRole("Administrator")
            || Guid.TryParse(userIdValue, out userId)
            && course.Staff.Any(member =>
                member.UserId == userId
                && member.Role is "Instructor" or "TA");

        activeTab = NormalizeTab(Tab);
        activeAction = NormalizeAction(Action);
        candidates = [];
        students = [];
        assignments = [];
        auditEvents = [];
        templates = [];

        if (activeTab == AssignmentsTab)
        {
            assignments = await AssignmentApi.ListAssignmentsAsync(Id);
            if (activeAction == CreateAssignmentAction)
            {
                templates = await AssignmentApi.ListTemplatesAsync();
            }
        }
        else if (activeTab == StudentsTab)
        {
            students = await CourseApi.ListStudentsAsync(Id);
        }
        else if (activeTab == StaffTab
            && activeAction == AddCourseStaffAction)
        {
            var assignedIds = course.Staff
                .Select(member => member.UserId)
                .ToHashSet();
            candidates = (await CourseApi.ListStaffCandidatesAsync())
                .Where(candidate => !assignedIds.Contains(candidate.UserId))
                .ToArray();
        }
        else if (activeTab == ActivityTab)
        {
            auditEvents = await CourseApi.ListAuditEventsAsync(Id);
        }
    }

    private string NormalizeTab(string? tab) =>
        tab switch
        {
            StudentsTab when canManage => StudentsTab,
            StaffTab => StaffTab,
            ActivityTab when canManage => ActivityTab,
            _ => AssignmentsTab,
        };

    private string? NormalizeAction(string? action) =>
        (activeTab, action, canManage) switch
        {
            (AssignmentsTab, CreateAssignmentAction, true) =>
                CreateAssignmentAction,
            (StudentsTab, ImportStudentsAction, true) =>
                ImportStudentsAction,
            (StaffTab, AddCourseStaffAction, true) =>
                AddCourseStaffAction,
            _ => null,
        };

    private string GetActionUrl(string tab, string? action) =>
        action is null
            ? $"/courses/{Id}?tab={tab}"
            : $"/courses/{Id}?tab={tab}&action={action}";
}
