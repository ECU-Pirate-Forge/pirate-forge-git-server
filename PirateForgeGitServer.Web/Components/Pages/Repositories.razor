@page "/repositories"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using PirateForgeGitServer.Contracts.Courses
@using PirateForgeGitServer.Web.Assignments
@using PirateForgeGitServer.Web.Courses
@inject CourseApiClient CourseApi
@inject AssignmentApiClient AssignmentApi

<PageTitle>Repositories</PageTitle>

<div class="page-header">
    <div>
        <h1>Repositories</h1>
        <p>Browse course work by course and assignment.</p>
    </div>
</div>

@if (rows.Count == 0)
{
    <FluentMessageBar Intent="MessageBarIntent.Info">
        No repositories are available.
    </FluentMessageBar>
}
else
{
    <CourseRepositoryList Rows="@rows" />
}

@code {
    private IReadOnlyList<CourseRepositoryRow> rows = [];

    protected override async Task OnInitializedAsync()
    {
        var courses = await CourseApi.ListAsync();
        var repositoryRows = new List<CourseRepositoryRow>();

        foreach (var course in courses)
        {
            var assignments = await AssignmentApi.ListAssignmentsAsync(course.Id);
            repositoryRows.AddRange(assignments.Select(
                assignment => new CourseRepositoryRow(course, assignment)));
        }

        rows = repositoryRows;
    }
}
