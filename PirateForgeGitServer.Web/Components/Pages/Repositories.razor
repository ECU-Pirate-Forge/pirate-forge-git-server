@page "/repositories"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using PirateForgeGitServer.Contracts.Courses
@using PirateForgeGitServer.Web.Assignments
@using PirateForgeGitServer.Web.Courses
@inject CourseApiClient CourseApi
@inject AssignmentApiClient AssignmentApi

<PageTitle>Repositories</PageTitle>

<h1>Repositories</h1>
<p>Browse course work by course and assignment.</p>

@if (courseGroups.Count == 0)
{
    <FluentMessageBar Intent="MessageBarIntent.Info">
        No repositories are available.
    </FluentMessageBar>
}
else
{
    @foreach (var courseGroup in courseGroups)
    {
        <FluentCard>
            <h2>
                <FluentLink Href="@($"/courses/{courseGroup.Course.Id}")">
                    @courseGroup.Course.Code · @courseGroup.Course.Name
                </FluentLink>
            </h2>

            @if (courseGroup.Assignments.Count == 0)
            {
                <p>No assignments have been created for this course yet.</p>
            }
            else
            {
                @foreach (var assignment in courseGroup.Assignments)
                {
                    <article>
                        <h3>
                            <FluentLink Href="@($"/courses/{courseGroup.Course.Id}/assignments/{assignment.Id}/repositories")">
                                @assignment.Title
                            </FluentLink>
                        </h3>
                        <p><code>@assignment.Slug</code></p>
                    </article>
                }
            }
        </FluentCard>
    }
}

@code {
    private IReadOnlyList<CourseRepositoryGroup> courseGroups = [];

    protected override async Task OnInitializedAsync()
    {
        var courses = await CourseApi.ListAsync();
        var groups = new List<CourseRepositoryGroup>();

        foreach (var course in courses)
        {
            var assignments = await AssignmentApi.ListAssignmentsAsync(course.Id);
            groups.Add(new CourseRepositoryGroup(course, assignments));
        }

        courseGroups = groups;
    }

    private sealed record CourseRepositoryGroup(
        CourseResponse Course,
        IReadOnlyList<AssignmentResponse> Assignments);
}
