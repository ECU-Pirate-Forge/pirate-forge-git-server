@using PirateForgeGitServer.Contracts.Git
@rendermode InteractiveServer

@if (Templates.Count == 0)
{
    <FluentMessageBar Intent="MessageBarIntent.Info">
        No repository templates are available.
    </FluentMessageBar>
}
else
{
    <FluentCard Class="data-grid-card">
        <div class="grid-toolbar">
            <FluentTextInput @bind-Value="filter"
                             Label="Filter templates"
                             Placeholder="Search templates"
                             Type="TextInputType.Search"
                             Immediate="true"
                             ImmediateDelay="150" />
            <span class="grid-count">@filteredTemplates.Count template(s)</span>
        </div>
        @if (filteredTemplates.Count == 0)
        {
            <div class="empty-state">No templates match your filter.</div>
        }
        else
        {
            <div class="data-grid-scroll">
                <FluentDataGrid Items="@filteredTemplates.AsQueryable()"
                                TGridItem="RepositoryTemplateResponse"
                                ResizableColumns="true"
                                ShowHover="true"
                                MultiLine="true">
                    <PropertyColumn Property="@(template => template.DisplayName)"
                                    Title="Template"
                                    Sortable="true"
                                    IsDefaultSortColumn="true" />
                    <PropertyColumn Property="@(template => template.Name)"
                                    Title="Repository"
                                    Sortable="true" />
                    <PropertyColumn Property="@(template => template.Purpose)"
                                    Title="Purpose"
                                    Sortable="true" />
                    <PropertyColumn Property="@(template => template.CreatedAt)"
                                    Title="Created"
                                    Format="d"
                                    Sortable="true" />
                    <TemplateColumn Title="Actions">
                        <FluentAnchorButton Href="@($"/repositories/{context.Name}")"
                                            Appearance="ButtonAppearance.Outline">
                            Browse repository
                        </FluentAnchorButton>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        }
    </FluentCard>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<RepositoryTemplateResponse> Templates { get; set; }

    private string? filter;
    private IReadOnlyList<RepositoryTemplateResponse> filteredTemplates =>
        string.IsNullOrWhiteSpace(filter)
            ? Templates
            : Templates.Where(template =>
                    template.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || template.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || template.Purpose.Contains(filter, StringComparison.OrdinalIgnoreCase))
                .ToList();
}
