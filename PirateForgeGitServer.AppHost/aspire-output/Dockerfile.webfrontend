FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src

COPY Directory.Packages.props .
COPY PirateForgeGitServer.Web/*.csproj ./PirateForgeGitServer.Web/
COPY PirateForgeGitServer.Contracts/*.csproj ./PirateForgeGitServer.Contracts/
COPY PirateForgeGitServer.ServiceDefaults/*.csproj ./PirateForgeGitServer.ServiceDefaults/

RUN dotnet restore PirateForgeGitServer.Web/PirateForgeGitServer.Web.csproj

COPY . .
RUN dotnet publish PirateForgeGitServer.Web/PirateForgeGitServer.Web.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/nightly/aspnet:11.0-resolute
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "PirateForgeGitServer.Web.dll"]
